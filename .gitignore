# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/dist/
frontend/build/

# Logs
*.log
backend/backend.log

# macOS
.DS_Store

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/

# MCP auth cache (contains tokens)
~/.mcp-auth/

# One-off debugging probes — keep them local, don't commit
scratch*.py
scratch*.js

# local worktrees and secret-file backups
.claude/
.env*

# Database exports. trade_log dumps carry real fills and positions; the macro
# dumps are recoverable from FRED at any time. Neither is source, and neither
# belongs in a repo with a public remote.
backups/
